# Realmweaver AI Configuration
# Copy this file to .env.local and fill in your values

# AI Provider: 'claude-cli' (default, uses local Claude Code) or 'anthropic-api'
# (direct API — stub, not yet implemented: every call throws)
REALMWEAVER_AI_PROVIDER=claude-cli

# Claude CLI path (only needed if 'claude' is not on your PATH)
# CLAUDE_CLI_PATH=/home/user/.local/bin/claude

# Anthropic API key (only needed if using the 'anthropic-api' provider — see the stub caveat above)
# ANTHROPIC_API_KEY=sk-ant-...

# Default model tier: 'lite', 'standard' (default), or 'quality'
# REALMWEAVER_DEFAULT_TIER=standard

# Real-time audio transcription (AI Scribe in Session Logs) has no env var — its Google
# API key is entered per-campaign in Campaign Settings and stored on that campaign.

# Opt-in: run smokeTest.ts's full CRUD/service smoke suite on app startup in dev.
# Off by default — enabling this wipes the 'realmweaver-campaigns' /
# 'realmweaver-active-campaign-id' storage keys on every mount and, with Mock
# Mode off, fires ~20 live AI calls against the real provider.
# VITE_RUN_SMOKE_TESTS=true
